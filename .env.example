# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM configuration (leave LLM_MODEL blank by default; set explicitly if used)
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=3.0

# Model & Embeddings
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=64

# Catalog & Index storage
DATA_DIR=data
DB_PATH=data/catalog.db
FAISS_INDEX_PATH=data/faiss.index
BM25_INDEX_PATH=data/bm25.pkl
ID_MAP_PATH=data/id_map.json
HELD_OUT_PATH=data/held_out_products.jsonl

# Ingestion & Sampling policies
SAMPLE_SIZE=30000
HELD_OUT_FRACTION=0.2
INCLUDE_UNKNOWN_PRICE=false
RANDOM_SEED=42
ADMIN_API_KEY=
MAX_BATCH_SIZE=500

# Search & Retrieval policies
RRF_K=60
RETRIEVAL_TOP_K=50
MIN_SIMILARITY_THRESHOLD=0.0
LOW_CONFIDENCE_SIMILARITY=0.6191
LRU_CACHE_SIZE=1000
GENDER_INCLUDE_UNKNOWN=false
BAYESIAN_M=10.0
QUALITY_BOOST_WEIGHT=0.05
